# Copy to .env and fill in. .env is git-ignored — NEVER commit real values.
# Auth is Application Default Credentials: run `gcloud auth application-default login`.
# Do NOT put a service-account key here for local dev.

# ---- GCP project & region ----
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# ---- Bronze storage (raw CSV, partitioned by year/month) ----
GCS_BUCKET=your-bronze-bucket-name

# ---- BigQuery ----
# Datasets for the medallion layers. Must match the datasets you create in GCP.
BQ_LOCATION=US
BQ_BRONZE_DATASET=flight_delays_bronze
BQ_SILVER_DATASET=flight_delays_silver
BQ_GOLD_DATASET=flight_delays_gold

# ---- dbt ----
# profiles.yml lives in ./dbt and reads the vars above.
DBT_PROFILES_DIR=./dbt

# ---- MLflow experiment tracking (ml/tracking.py; optional) ----
# Run metadata uses a LOCAL SQLite backend; when unset it defaults to the
# git-ignored mlflow.db at the REPO ROOT. Point MLFLOW_TRACKING_URI at a tracking
# server to keep metadata in the cloud. Artifacts (models, metrics.json) go to
# gs://$GCS_BUCKET/mlflow — reuses the bucket above; nothing extra to set.
# Tracking degrades gracefully if offline.
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db   # override; relative paths are CWD-based
# MLFLOW_EXPERIMENT=flight-delay
# MLFLOW_TRACKING=on            # set to "off" to disable tracking entirely

# ---- CI ONLY (leave blank locally; local uses `gcloud auth ... login`) ----
# Path to a service-account key mounted by CI. Local dev must NOT set this.
# GOOGLE_APPLICATION_CREDENTIALS=

# ---- SERVING (ml/api.py, the predictor service) ----
# api.weather.gov asks for a User-Agent that identifies the client and gives
# them a contact. Required before running the predictor as a deployed service;
# unset falls back to a "no contact configured" UA and logs a warning.
# NWS_CONTACT_EMAIL=you@example.com
#
# The artifact run baked into the predictor image, e.g. 20260730_145241.
# ml/publish.py uploads it to gs://$GCS_BUCKET/serving/<run>/ and
# cloudbuild.predictor.yaml pulls that exact run — pinned, never "latest".
# SERVING_ARTIFACT_RUN=
#
# Base URL of the deployed predictor, read by the dashboard's prediction pages.
# Unset simply disables those pages; it must never break the BI pages.
# PREDICTOR_URL=https://flight-delay-predictor-xxxxx-uc.a.run.app
