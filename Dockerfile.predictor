# Cloud Run image for the prediction API (ml/api.py).
#
# Separate from the dashboard's Dockerfile ON PURPOSE. This image carries
# xgboost + scikit-learn and ~695 MB of model artifacts; folding that into the
# dashboard would put an artifact load on every cold start for every visitor
# who only wanted the delay map, force its memory up for all traffic, and let a
# bad artifact take the live BI app down. dashboard/ must never import ml/.
#
# ARTIFACTS ARE BAKED, NOT FETCHED AT STARTUP. cloudbuild.predictor.yaml copies
# gs://$_BUCKET/serving/$_RUN into ./ml_artifacts first, so load_models() keeps
# reading a local directory with zero new runtime code and the image is
# immutably tied to one pinned run. Fetching at startup would add a failure mode
# and 10-30s to every cold start.
#
# Auth is ADC from the Cloud Run runtime service account — no key file, per
# CLAUDE.md §2. The serving lookup tables must be built (dbt build -s
# serving_entity_profile serving_density_profile serving_typical_rotation)
# BEFORE a new image is deployed; startup fails loudly if they are absent.

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /bin/uv

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Dependency layer: cache-friendly, locked, no dev tooling.
# `serve` = fastapi/uvicorn, `ml` = xgboost/sklearn/joblib, `ingestion` = the
# env loader in ingestion/config.py that everything else reads through.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev \
      --extra ml --extra serve --extra ingestion

# App code. The project itself is not installed, so make /app importable.
COPY ingestion/ ingestion/
COPY ml/ ml/

# The pinned artifact run, staged into the build context by Cloud Build.
# ml/artifacts/ is git-ignored and holds every local training run (~17 GB), so
# this is a SEPARATE directory name — un-ignoring ml/artifacts/ would drag all
# of them into the build context, including the dashboard's.
COPY ml_artifacts/ ml/artifacts/

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app

# Cloud Run injects PORT (default 8080). One worker: each would hold its own
# copy of the ~695 MB of boosters, and Cloud Run scales by instance anyway.
EXPOSE 8080
CMD ["sh", "-c", "uvicorn ml.api:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
